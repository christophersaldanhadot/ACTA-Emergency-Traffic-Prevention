VITE_API_BASE_URL=http://127.0.0.1:8000

# Browser-side Google Maps API key for the Places Autocomplete widget
# (Origin/Destination inputs). This is a DIFFERENT key from the
# backend's GOOGLE_MAPS_API_KEY (used server-side for the Routes API)
# -- never reuse that key here, since anything in a VITE_ env var ships
# inside the built JS bundle and is visible to anyone using the app.
# In Google Cloud Console: create a separate key, enable the Places
# API (New) and Maps JavaScript API for it, and set an HTTP-referrer
# restriction to your app's domain(s) before deploying.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCX3OLlcuub0uuWRjkJCGWI1B6Lbo01cbU
